{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/arm-gcc.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BLACKPILL_HIL": "OFF"
      },
      "description": "Собственный CMake/CMSIS, тулчейн ARM GCC. Без HAL; ARM_TOOLCHAIN_ROOT или PATH."
    },
    {
      "name": "f411ce-debug",
      "displayName": "DEBUG (F411CE)",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "F411CE",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "f411ce-release",
      "displayName": "RELEASE (F411CE)",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "F411CE",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "f411ce-hil",
      "displayName": "HIL (F411CE)",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "F411CE",
        "CMAKE_BUILD_TYPE": "Debug",
        "BLACKPILL_HIL": "ON"
      }
    },
    {
      "name": "f401cc-debug",
      "displayName": "DEBUG (F401CC)",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "F401CC",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "f401cc-release",
      "displayName": "RELEASE (F401CC)",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "F401CC",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "f401cc-hil",
      "displayName": "HIL (F401CC)",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "F401CC",
        "CMAKE_BUILD_TYPE": "Debug",
        "BLACKPILL_HIL": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "f411ce-debug", "configurePreset": "f411ce-debug" },
    { "name": "f411ce-release", "configurePreset": "f411ce-release" },
    { "name": "f411ce-hil", "configurePreset": "f411ce-hil" },
    { "name": "f401cc-debug", "configurePreset": "f401cc-debug" },
    { "name": "f401cc-release", "configurePreset": "f401cc-release" },
    { "name": "f401cc-hil", "configurePreset": "f401cc-hil" }
  ],
  "testPresets": [
    {
      "name": "f411ce-hil-host",
      "configurePreset": "f411ce-hil",
      "filter": { "include": { "label": "^host$" } },
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "jobs": 1 }
    },
    {
      "name": "f411ce-hil-hw",
      "configurePreset": "f411ce-hil",
      "filter": { "include": { "label": "^hw$" } },
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "jobs": 1 },
      "environment": { "STM32_GDBTEST_STAND": "${sourceDir}/hil/F411CE/stands/local.toml" }
    },
    {
      "name": "f401cc-hil-host",
      "configurePreset": "f401cc-hil",
      "filter": { "include": { "label": "^host$" } },
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "jobs": 1 }
    },
    {
      "name": "f401cc-hil-hw",
      "configurePreset": "f401cc-hil",
      "filter": { "include": { "label": "^hw$" } },
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "jobs": 1 },
      "environment": { "STM32_GDBTEST_STAND": "${sourceDir}/hil/F401CC/stands/local.toml" }
    }
  ]
}
