{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "CMAKE_USER_HOME": "$penv{USERPROFILE}"
      },
      "cacheVariables": {
        "STM32_TOOLCHAIN_PATH": "$penv{USERPROFILE}/xpack-arm-none-eabi-gcc-13.3.1-1.1",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_C_FLAGS_DEBUG": "-Og -g3",
        "CMAKE_CXX_FLAGS_DEBUG": "-Og -g3",
        "STM32_YML_PROFILE": "f411"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "BlackPill Debug (GCC 13)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "BlackPill Release (GCC 13)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug-gcc14",
      "inherits": "debug",
      "cacheVariables": {
        "STM32_TOOLCHAIN_PATH": "$penv{USERPROFILE}/xpack-arm-none-eabi-gcc-14.2.1-1.1"
      }
    },
    {
      "name": "debug-gcc15",
      "inherits": "debug",
      "cacheVariables": {
        "STM32_TOOLCHAIN_PATH": "$penv{USERPROFILE}/xpack-arm-none-eabi-gcc-15.2.1-1.1"
      }
    },
    {
      "name": "debug-hwtest",
      "inherits": "debug",
      "displayName": "BlackPill Debug + HW tests",
      "cacheVariables": {
        "ENABLE_HW_TESTING": true
      }
    },
    {
      "name": "f103-debug",
      "inherits": "base",
      "displayName": "BluePill F103 Debug (GCC 13)",
      "cacheVariables": {
        "STM32_YML_PROFILE": "f103",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug-gcc14",
      "configurePreset": "debug-gcc14"
    },
    {
      "name": "debug-gcc15",
      "configurePreset": "debug-gcc15"
    },
    {
      "name": "debug-hwtest",
      "configurePreset": "debug-hwtest"
    },
    {
      "name": "check-hw",
      "configurePreset": "debug-hwtest",
      "targets": [
        "check-hw"
      ]
    },
    {
      "name": "f103-debug",
      "configurePreset": "f103-debug"
    }
  ],
  "testPresets": [
    {
      "name": "hw",
      "configurePreset": "debug-hwtest",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "host",
      "configurePreset": "debug-hwtest",
      "filter": {
        "include": {
          "label": "host"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
