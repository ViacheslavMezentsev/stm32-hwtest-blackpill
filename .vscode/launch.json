{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "F411CE / ST-Link / OpenOCD",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/HIL_F411CE/stm32_hwtest_blackpill.elf",
      "servertype": "openocd",
      "device": "STM32F411CE",
      "interface": "swd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f4x.cfg"
      ],
      "preLaunchTask": "Build F411CE",
      "runToEntryPoint": "main",
      "svdFile": "${workspaceFolder}/resources/STM32F411.svd",
      "openOCDLaunchCommands": [
        "adapter serial ${input:stlinkSerial}"
      ]
    },
    {
      "name": "F401CC / ST-Link / OpenOCD",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/HIL_F401CC/stm32_hwtest_blackpill.elf",
      "servertype": "openocd",
      "device": "STM32F401CC",
      "interface": "swd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f4x.cfg"
      ],
      "preLaunchTask": "Build F401CC",
      "runToEntryPoint": "main",
      "svdFile": "${workspaceFolder}/resources/STM32F401.svd",
      "openOCDLaunchCommands": [
        "adapter serial ${input:stlinkSerial}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "stlinkSerial",
      "type": "promptString",
      "description": "ST-Link serial for the selected board"
    }
  ]
}
